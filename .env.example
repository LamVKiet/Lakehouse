# Kafka Configuration
KAFKA_VERSION=7.8.3
CLUSTER_ID=1L6g7nGhU-eAKfL--X25wo

# AWS Configuration (required for S3 + Glue)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-southeast-1
S3_BUCKET=apparel-retail-lakehouse

# Jupyter Configuration
JUPYTER_TOKEN=admin123

# Simulator Configuration
SIMULATOR_PORT=8000

# MySQL Configuration (backend raw SQL layer)
MYSQL_DB=apparel_retail
MYSQL_USER=app_user
MYSQL_PASSWORD=app_pass

# SMTP (Airflow failure alerts). For Gmail: create an App Password (16 chars, paste WITHOUT spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_MAIL_FROM=your_email@gmail.com
